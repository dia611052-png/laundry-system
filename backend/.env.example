# Copy this file to .env and fill in real values for your environment.
# .env holds secrets / environment-specific config and should never be
# committed to version control — it's already listed in .gitignore.

# --- Database (backend/config/database.php) ----------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=freshtrack
DB_USER=root
DB_PASS=

# --- WebSocket live-updates server (backend/config/websocket.php) ------
# Where ws-server.php itself binds and listens. 0.0.0.0 = every interface,
# fine for most deployments.
WS_HOST=0.0.0.0
WS_PORT=8080

# How often (in seconds) the server re-checks the database and pushes
# fresh data to connected clients.
WS_BROADCAST_INTERVAL=2

# The ws:// or wss:// address the BROWSER connects to.
# Leave blank for local dev — it auto-detects the page's own host on
# WS_PORT, over plain ws://. Set this explicitly once you're behind a
# reverse proxy, using TLS, or serving the site on a different public
# host/port than WS_PORT, e.g.:
#   WS_PUBLIC_URL=wss://freshtrack.example.com/ws
WS_PUBLIC_URL=

# --- Gemini API key (backend/config/gemini.php) -------------------------
# Powers the "predict finish time" feature on the customer dashboard.
# Get a free key at https://aistudio.google.com/apikey — leave blank to
# disable the feature (it'll return a clear error instead of failing).
GEMINI_KEY=

# Optional: defaults to gemini-flash-lite-latest (fastest/cheapest tier,
# plenty for this small structured-JSON task). Pin a specific version
# instead if you want reproducible behaviour, e.g. GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=

# Optional: used automatically if the primary model keeps returning
# "503 model is overloaded" after a few retries — a known Gemini-wide
# capacity issue, not specific to one model. Defaults to a pinned
# Flash-Lite version (a rolling "-latest" alias and a pinned version can
# land on different backing capacity).
GEMINI_FALLBACK_MODEL=
